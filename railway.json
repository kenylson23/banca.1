{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --registry=https://registry.npmjs.org/ --no-audit --no-fund && npm run build"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production npm run db:ensure-table-session-columns && SERVE_STATIC=true NODE_ENV=production node dist/index.js",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
