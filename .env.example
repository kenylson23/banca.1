# NaBancada - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores

# ========================================
# DATABASE
# ========================================
# URL de conexão com PostgreSQL
# Formato: postgresql://user:password@host:port/database
# Railway PostgreSQL: Use a DATABASE_URL fornecida pelo serviço PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/nabancada

# ========================================
# APPLICATION
# ========================================
# Ambiente de execução (development ou production)
NODE_ENV=development

# Porta do servidor (Railway define automaticamente em produção)
PORT=5000

# ========================================
# SEPARATE DEPLOY (RAILWAY + VERCEL)
# ========================================
# Domínio(s) do frontend Vercel, separados por vírgula e sem barra final
# Obrigatório no Railway em produção para CORS e cookies de sessão
# CORS_ORIGINS=https://seu-app.vercel.app
# URL pública do backend Railway (somente no frontend/Vercel)
# VITE_API_URL=https://seu-backend.up.railway.app

# ========================================
# SECURITY
# ========================================
# Chave secreta para sessões (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=sua-chave-secreta-super-segura-com-32-ou-mais-caracteres

# ========================================
# OPTIONAL - PostgreSQL Details (se necessário)
# ========================================
# Estas variáveis são extraídas automaticamente da DATABASE_URL
# Só configure manualmente se absolutamente necessário
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=senha
# PGDATABASE=nabancada
# PGPORT=5432

# ========================================
# DEBUG - Apenas para desenvolvimento/troubleshooting
# ========================================
# Habilita logs detalhados e ferramentas de diagnóstico
# NUNCA USE EM PRODUÇÃO por questões de segurança
# DEBUG_AUTH=true
# VITE_DEBUG_AUTH=true
